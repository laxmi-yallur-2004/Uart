#include <LiquidCrystal.h>

// LCD pins
LiquidCrystal lcd(8, 9, 4, 5, 6, 7);

// ==================================================
// DEVICE STATES
// ==================================================

enum DeviceState
{
  IDLE,
  RUNNING,
  DONE
};

DeviceState state = IDLE;

unsigned long startTime = 0;

// ==================================================
// BUTTON HANDLING
// ==================================================

const int BUTTON_THRESHOLD = 100;

// Button state tracking
bool buttonPressed = false;
bool lastButtonState = false;

// Debounce timing
unsigned long lastDebounceTime = 0;
const unsigned long debounceDelay = 50;

// ==================================================
// SETUP
// ==================================================

void setup()
{
  lcd.begin(16, 2);
  Serial.begin(9600);

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("DEVICE WORKFLOW");

  lcd.setCursor(0, 1);
  lcd.print("IDLE");

  Serial.println("State: IDLE");
}

// ==================================================
// LOOP
// ==================================================

void loop()
{
  unsigned long currentTime = millis();

  // ==================================================
  // READ BUTTON
  // ==================================================

  bool reading = (analogRead(A0) < BUTTON_THRESHOLD);

  // If button reading changed, restart debounce timer
  if (reading != lastButtonState)
  {
    lastDebounceTime = currentTime;
  }

  // Accept button state only after it remains stable
  if ((currentTime - lastDebounceTime) > debounceDelay)
  {
    if (reading != buttonPressed)
    {
      buttonPressed = reading;

      // Only react when button becomes PRESSED
      if (buttonPressed)
      {
        // ==================================================
        // START ONLY FROM IDLE
        // ==================================================

        if (state == IDLE)
        {
          state = RUNNING;
          startTime = currentTime;

          lcd.clear();
          lcd.setCursor(0, 0);
          lcd.print("STATE:");
          lcd.setCursor(0, 1);
          lcd.print("RUNNING");

          Serial.println("State: RUNNING");
        }
      }
    }
  }

  lastButtonState = reading;

  // ==================================================
  // STATE MACHINE
  // ==================================================

  switch (state)
  {
    // --------------------------------------------------
    // IDLE
    // --------------------------------------------------

    case IDLE:

      // Button handling is done above.
      // Nothing else is required here.

      break;


    // --------------------------------------------------
    // RUNNING
    // --------------------------------------------------

    case RUNNING:

      // Run for 5 seconds without blocking
      if (currentTime - startTime >= 5000)
      {
        state = DONE;

        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("STATE:");
        lcd.setCursor(0, 1);
        lcd.print("DONE");

        Serial.println("State: DONE");
      }

      break;


    // --------------------------------------------------
    // DONE
    // --------------------------------------------------

    case DONE:

      // After 2 seconds, return to IDLE
      if (currentTime - startTime >= 7000)
      {
        state = IDLE;

        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("STATE:");
        lcd.setCursor(0, 1);
        lcd.print("IDLE");

        Serial.println("State: IDLE");
      }

      break;
  }
}
