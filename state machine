#include <LiquidCrystal.h>

LiquidCrystal lcd(8, 9, 4, 5, 6, 7);

// States
enum DeviceState
{
  IDLE,
  RUNNING,
  DONE
};

DeviceState state = IDLE;

unsigned long startTime = 0;

void setup()
{
  lcd.begin(16, 2);
  Serial.begin(9600);

  pinMode(2, INPUT_PULLUP);

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("STATE:");
  lcd.setCursor(0, 1);
  lcd.print("IDLE");

  Serial.println("State: IDLE");
}

void loop()
{
  unsigned long currentTime = millis();

  switch (state)
  {
    case IDLE:

      // Button pressed
      if (digitalRead(2) == LOW)
      {
        state = RUNNING;
        startTime = currentTime;

        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("STATE:");
        lcd.setCursor(0, 1);
        lcd.print("RUNNING");

        Serial.println("State: RUNNING");

        delay(200);   // simple button debounce
      }

      break;


    case RUNNING:

      // Stay RUNNING for 5 seconds
      if (currentTime - startTime >= 5000)
      {
        state = DONE;

        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("STATE:");
        lcd.setCursor(0, 1);
        lcd.print("DONE");

        Serial.println("State: DONE");
      }

      break;


    case DONE:

      // Stay DONE for 2 seconds
      if (currentTime - startTime >= 7000)
      {
        state = IDLE;

        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("STATE:");
        lcd.setCursor(0, 1);
        lcd.print("IDLE");

        Serial.println("State: IDLE");
      }

      break;
  }
}
