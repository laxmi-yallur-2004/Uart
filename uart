#include <LiquidCrystal.h>

LiquidCrystal lcd(8, 9, 4, 5, 6, 7);

#define SIZE 16

// RX buffer
char rxBuffer[SIZE];
int rxHead = 0;
int rxTail = 0;
int rxOverflow = 0;

// TX buffer
char txBuffer[SIZE];
int txHead = 0;
int txTail = 0;
int txOverflow = 0;


// Add data to buffer
bool addData(char buffer[], int &head, int tail, int &overflow, char data)
{
  int next = head + 1;

  if (next == SIZE)
    next = 0;

  // Buffer full
  if (next == tail)
  {
    overflow++;
    return false;
  }

  buffer[head] = data;
  head = next;

  return true;
}


// Remove data from buffer
bool getData(char buffer[], int &head, int &tail, char &data)
{
  // Buffer empty
  if (head == tail)
    return false;

  data = buffer[tail];

  tail++;

  if (tail == SIZE)
    tail = 0;

  return true;
}


void setup()
{
  Serial.begin(9600);

  lcd.begin(16, 2);

  // ---------------- TESTS ----------------

  int pass = 0;
  int fail = 0;

  char data;

  // Test 1: Empty buffer
  if (rxHead == rxTail)
  {
    Serial.println("PASS: Buffer Empty");
    pass++;
  }
  else
  {
    Serial.println("FAIL: Buffer Empty");
    fail++;
  }


  // Test 2: Put A
  if (addData(rxBuffer, rxHead, rxTail, rxOverflow, 'A'))
  {
    Serial.println("PASS: Put A");
    pass++;
  }
  else
  {
    Serial.println("FAIL: Put A");
    fail++;
  }


  // Test 3: Get A
  if (getData(rxBuffer, rxHead, rxTail, data) && data == 'A')
  {
    Serial.println("PASS: Get A");
    pass++;
  }
  else
  {
    Serial.println("FAIL: Get A");
    fail++;
  }


  // Test 4: FIFO
  addData(rxBuffer, rxHead, rxTail, rxOverflow, 'A');
  addData(rxBuffer, rxHead, rxTail, rxOverflow, 'B');
  addData(rxBuffer, rxHead, rxTail, rxOverflow, 'C');

  getData(rxBuffer, rxHead, rxTail, data);

  if (data == 'A')
  {
    getData(rxBuffer, rxHead, rxTail, data);

    if (data == 'B')
    {
      getData(rxBuffer, rxHead, rxTail, data);

      if (data == 'C')
      {
        Serial.println("PASS: FIFO A B C");
        pass++;
      }
      else
        fail++;
    }
    else
      fail++;
  }
  else
    fail++;


  // Test 5: Overflow
  rxHead = 0;
  rxTail = 0;
  rxOverflow = 0;

  for (int i = 0; i < SIZE - 1; i++)
  {
    addData(rxBuffer, rxHead, rxTail, rxOverflow, 'X');
  }

  // Try adding one more
  addData(rxBuffer, rxHead, rxTail, rxOverflow, 'Y');

  if (rxOverflow == 1)
  {
    Serial.println("PASS: Overflow");
    pass++;
  }
  else
  {
    Serial.println("FAIL: Overflow");
    fail++;
  }


  // ---------------- RESULT ----------------

  Serial.println();
  Serial.print("TOTAL PASS: ");
  Serial.println(pass);

  Serial.print("TOTAL FAIL: ");
  Serial.println(fail);


  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("PASS:");
  lcd.print(pass);

  lcd.setCursor(9, 0);
  lcd.print("FAIL:");
  lcd.print(fail);

  lcd.setCursor(0, 1);

  if (fail == 0)
    lcd.print("MODULE 1 PASS");
  else
    lcd.print("CHECK FAILURES");
}


void loop()
{
  char data;

  // PC -> RX buffer
  while (Serial.available())
  {
    data = Serial.read();

    addData(rxBuffer, rxHead, rxTail, rxOverflow, data);
  }


  // RX buffer -> TX buffer
  if (getData(rxBuffer, rxHead, rxTail, data))
  {
    addData(txBuffer, txHead, txTail, txOverflow, data);
  }


  // TX buffer -> PC
  if (getData(txBuffer, txHead, txTail, data))
  {
    Serial.write(data);
  }
}
