#include <LiquidCrystal.h>

LiquidCrystal lcd(8, 9, 4, 5, 6, 7);

#define SIZE 16

struct Buffer {
  char data[SIZE];
  byte head = 0;
  byte tail = 0;
  int overflow = 0;
};

Buffer rx, tx;

bool put(Buffer &b, char c)
{
  byte next = (b.head + 1) % SIZE;

  if (next == b.tail) {
    b.overflow++;
    return false;
  }

  b.data[b.head] = c;
  b.head = next;
  return true;
}

bool get(Buffer &b, char &c)
{
  if (b.head == b.tail)
    return false;

  c = b.data[b.tail];
  b.tail = (b.tail + 1) % SIZE;
  return true;
}

void setup()
{
  Serial.begin(9600);

  lcd.begin(16, 2);
  lcd.print("Module 1 Test");

  // ---------- TEST ----------
  Buffer test;
  char c;

  // Empty test
  bool t1 = (test.head == test.tail);

  // Put A and get A
  put(test, 'A');
  bool t2 = get(test, c) && c == 'A';

  // FIFO test
  put(test, 'A');
  put(test, 'B');
  put(test, 'C');

  get(test, c);
  bool t3 = c == 'A';

  get(test, c);
  bool t4 = c == 'B';

  get(test, c);
  bool t5 = c == 'C';

  // Overflow test
  test.head = 0;
  test.tail = 0;
  test.overflow = 0;

  for (int i = 0; i < SIZE - 1; i++)
    put(test, 'X');

  bool t6 = !put(test, 'Y');
  bool t7 = test.overflow == 1;

  int pass = t1 + t2 + t3 + t4 + t5 + t6 + t7;
  int fail = 7 - pass;

  Serial.println("===== MODULE 1 TESTS =====");

  Serial.println(t1 ? "PASS: Empty" : "FAIL: Empty");
  Serial.println(t2 ? "PASS: Put/Get" : "FAIL: Put/Get");
  Serial.println(t3 && t4 && t5 ? "PASS: FIFO" : "FAIL: FIFO");
  Serial.println(t6 ? "PASS: Overflow" : "FAIL: Overflow");
  Serial.println(t7 ? "PASS: Counter" : "FAIL: Counter");

  Serial.print("TOTAL PASS: ");
  Serial.println(pass);

  Serial.print("TOTAL FAIL: ");
  Serial.println(fail);

  lcd.clear();
  lcd.print("PASS:");
  lcd.print(pass);

  lcd.setCursor(9, 0);
  lcd.print("FAIL:");
  lcd.print(fail);

  lcd.setCursor(0, 1);

  if (fail == 0)
    lcd.print("MODULE 1 PASS");
  else
    lcd.print("CHECK FAILURES");
}

void loop()
{
  char c;

  // PC -> RX
  while (Serial.available()) {
    put(rx, Serial.read());
  }

  // RX -> TX
  if (get(rx, c))
    put(tx, c);

  // TX -> PC
  if (get(tx, c))
    Serial.write(c);
}
